{
  "name": "cobble-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter cobble-ui build && pnpm --filter site build",
    "dev": "pnpm --filter cobble-ui build && pnpm --parallel --filter cobble-ui --filter site dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0"
}
