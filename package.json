{
  "name": "cobble-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter cobble-ui build && pnpm --filter site build",
    "dev": "pnpm --filter cobble-ui build && pnpm --parallel --filter cobble-ui --filter site dev",
    "test": "pnpm -r test",
    "test:visual": "pnpm --filter site test:visual",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0"
}
