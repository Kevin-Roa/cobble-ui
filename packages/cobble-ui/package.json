{
  "name": "cobble-ui",
  "version": "0.1.2",
  "description": "React components for building pixel-accurate Minecraft: Java Edition-style interfaces. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
  "keywords": [
    "components",
    "gui",
    "minecraft",
    "minecraft-ui",
    "pixel-art",
    "react",
    "ui"
  ],
  "homepage": "https://kevin-roa.github.io/cobble-ui/",
  "bugs": {
    "url": "https://github.com/kevin-roa/cobble-ui/issues"
  },
  "license": "MIT",
  "author": "Kevin Roa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kevin-Roa/cobble-ui",
    "directory": "packages/cobble-ui"
  },
  "bin": {
    "cobble-ui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "sprite-ids:check": "node scripts/check-sprite-ids.mjs",
    "sprite-ids:write": "node scripts/check-sprite-ids.mjs --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
